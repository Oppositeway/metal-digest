---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		.tag-filters {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 1.5rem;
			}
			.tag-btn {
				padding: 0.25em 0.75em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				background: white;
				color: rgb(var(--gray-dark));
				font-size: 0.8em;
				cursor: pointer;
				font-family: inherit;
				transition: 0.15s ease;
			}
			.tag-btn:hover,
			.tag-btn.active {
				background: var(--accent);
				border-color: var(--accent);
				color: white;
			}
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.3rem;
				margin: 0.3rem 0 0;
			}
			.tag-link {
				font-size: 0.7em;
				padding: 0.15em 0.5em;
				border-radius: 999px;
				border: 1px solid rgb(var(--gray-light));
				color: rgb(var(--gray));
				text-decoration: none;
				transition: 0.15s ease;
			}
			.tag-link:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<nav class="tag-filters">
						<button class="tag-btn" data-tag="">Все</button>
						{allTags.map((tag) => (
							<button class="tag-btn" data-tag={tag}>{tag}</button>
						))}
					</nav>
					<ul id="post-list">
					{
						posts.map((post) => (
							<li data-tags={post.data.tags.join(' ')}>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									{post.data.tags.length > 0 && (
										<p class="post-tags">
											{post.data.tags.map((tag) => (
												<a
													href={`/blog?tag=${tag}`}
													class="tag-link"
													onclick="event.stopPropagation()"
												>
													{tag}
												</a>
											))}
										</p>
									)}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	<script>
	function applyFilter(tag: string) {
		document.querySelectorAll<HTMLButtonElement>('.tag-btn').forEach((btn) => {
			btn.classList.toggle('active', btn.dataset.tag === tag);
		});
		document.querySelectorAll<HTMLLIElement>('#post-list li').forEach((li) => {
			if (!tag) {
				li.hidden = false;
			} else {
				const tags = li.dataset.tags ?? '';
				li.hidden = !tags.split(' ').includes(tag);
			}
		});
	}

	document.addEventListener('DOMContentLoaded', () => {
		const params = new URLSearchParams(window.location.search);
		applyFilter(params.get('tag') ?? '');

		document.querySelectorAll<HTMLButtonElement>('.tag-btn').forEach((btn) => {
			btn.addEventListener('click', () => {
				const tag = btn.dataset.tag ?? '';
				const url = tag
					? `${window.location.pathname}?tag=${tag}`
					: window.location.pathname;
				history.pushState({}, '', url);
				applyFilter(tag);
			});
		});
	});
</script>
	</body>
</html>
