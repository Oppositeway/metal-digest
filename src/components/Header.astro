---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/tours">Туры</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="search-wrapper">
			<input
				type="search"
				id="search-input"
				placeholder="Поиск..."
				autocomplete="off"
				aria-label="Поиск по сайту"
			/>
			<ul id="search-results" class="search-results" hidden></ul>
		</div>
		<div class="social-links">
			<!-- TODO: заменить на реальные ссылки -->
			<a href="#" aria-label="Telegram">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8s3.58 8 8 8 8-3.58 8-8-3.58-8-8-8zm3.93 5.4-1.37 6.43c-.1.45-.37.56-.74.35l-2.06-1.52-.99.95c-.11.11-.2.2-.41.2l.15-2.1 3.8-3.44c.17-.15-.04-.23-.26-.09L4.9 9.63 2.87 9c-.45-.14-.46-.45.1-.67l7.68-2.96c.37-.14.7.09.58.67l-.3-.64z"/></svg>
			</a>
			<a href="#" aria-label="VK">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8s3.58 8 8 8 8-3.58 8-8-3.58-8-8-8zm4.07 9.07c.3.3.62.58.89.9.12.14.23.28.32.44.13.22.03.47-.17.48l-1.19-.01c-.31.03-.55-.1-.76-.31-.17-.17-.32-.35-.49-.52-.07-.07-.14-.13-.22-.18-.17-.1-.32-.07-.42.11-.1.18-.12.38-.13.58-.02.29-.1.37-.39.38-.6.03-1.17-.06-1.7-.36-.47-.27-.83-.65-1.15-1.08-.62-.83-1.08-1.75-1.5-2.69-.09-.21-.03-.33.2-.33.39-.01.77-.01 1.16-.01.15 0 .25.08.31.22.22.51.48 1 .8 1.45.09.12.18.24.31.32.14.09.25.06.32-.1.04-.1.06-.21.07-.32.03-.38.03-.76-.02-1.14-.03-.24-.16-.4-.4-.45-.12-.03-.1-.11-.04-.18.1-.12.2-.19.4-.19h1.34c.21.04.26.14.29.35l.01 1.5c0 .1.05.37.22.43.14.05.23-.06.32-.16.32-.38.54-.82.74-1.27.09-.2.17-.41.24-.62.06-.17.15-.25.34-.25l1.25.01c.04 0 .07 0 .11.01.21.04.27.13.21.33-.1.29-.28.54-.46.79l-.5.71c-.16.22-.14.33.05.52z"/></svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
	.search-wrapper {
		position: relative;
		flex: 0 1 200px;
	}
	#search-input {
		width: 100%;
		padding: 0.3em 0.6em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 4px;
		font-size: 0.85em;
		font-family: inherit;
		background: white;
		color: rgb(var(--black));
		box-sizing: border-box;
	}
	#search-input:focus {
		outline: 2px solid var(--accent);
		border-color: transparent;
	}
	.search-results {
		position: absolute;
		top: calc(100% + 4px);
		left: 0;
		right: 0;
		background: white;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 4px;
		box-shadow: var(--box-shadow);
		list-style: none;
		margin: 0;
		padding: 0;
		z-index: 100;
		max-height: 320px;
		overflow-y: auto;
		min-width: 260px;
	}
	.search-results li a {
		display: block;
		padding: 0.6em 0.8em;
		color: rgb(var(--black));
		text-decoration: none;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.search-results li:last-child a {
		border-bottom: none;
	}
	.search-results li a:hover {
		background: rgb(var(--gray-light));
		color: rgb(var(--black));
	}
	.result-title {
		display: block;
		font-size: 0.85em;
		font-weight: 700;
		line-height: 1.3;
	}
	.result-tags {
		display: block;
		font-size: 0.7em;
		color: rgb(var(--gray));
		margin-top: 0.2em;
	}
	.no-results {
		padding: 0.6em 0.8em;
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
	@media (max-width: 720px) {
		.search-wrapper {
			flex: 0 1 120px;
		}
	}
</style>
<script>
	let miniSearch: InstanceType<typeof import('minisearch').default> | null = null;
	let loaded = false;

	async function loadSearch() {
		if (loaded) return;
		loaded = true;
		const input = document.getElementById('search-input') as HTMLInputElement | null;
		try {
			const [{ default: MiniSearch }, data] = await Promise.all([
				import('minisearch'),
				fetch('/search.json').then((r) => r.json()),
			]);
			miniSearch = new MiniSearch({
				fields: ['title', 'description', 'tags', 'body'],
				storeFields: ['url', 'title', 'tags'],
				searchOptions: {
					boost: { title: 3, description: 2, tags: 2, body: 1 },
					prefix: true,
					fuzzy: 0.2,
				},
			});
			miniSearch.addAll(data);
		} catch {
			if (input) input.disabled = true;
		}
	}

	function renderResults(results: { url: string; title: string; tags: string }[]) {
		const list = document.getElementById('search-results') as HTMLUListElement | null;
		if (!list) return;
		list.innerHTML = '';
		if (results.length === 0) {
			const li = document.createElement('li');
			li.className = 'no-results';
			li.textContent = 'Ничего не найдено';
			list.appendChild(li);
		} else {
			results.slice(0, 6).forEach(({ url, title, tags }) => {
				const li = document.createElement('li');
				const a = document.createElement('a');
				a.href = url;
				const titleSpan = document.createElement('span');
				titleSpan.className = 'result-title';
				titleSpan.textContent = title;
				a.appendChild(titleSpan);
				if (tags) {
					const tagsSpan = document.createElement('span');
					tagsSpan.className = 'result-tags';
					tagsSpan.textContent = tags.split(' ').slice(0, 3).join(' · ');
					a.appendChild(tagsSpan);
				}
				li.appendChild(a);
				list.appendChild(li);
			});
		}
		list.hidden = false;
	}

	document.addEventListener('DOMContentLoaded', () => {
		const input = document.getElementById('search-input') as HTMLInputElement | null;
		const results = document.getElementById('search-results') as HTMLUListElement | null;
		if (!input || !results) return;

		input.addEventListener('focus', loadSearch);

		input.addEventListener('input', () => {
			const q = input.value.trim();
			if (q.length < 2) {
				results.hidden = true;
				return;
			}
			if (!miniSearch) return;
			renderResults(miniSearch.search(q) as { url: string; title: string; tags: string }[]);
		});

		input.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				results.hidden = true;
				input.blur();
			}
		});

		document.addEventListener('click', (e) => {
			const wrapper = document.querySelector('.search-wrapper');
			if (wrapper && !wrapper.contains(e.target as Node)) {
				results.hidden = true;
			}
		});
	});
</script>
